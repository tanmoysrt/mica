# Link between this node and S3, and the local disk limit. Each value can be
# overridden from the environment, such as `RTT_MS=20 lab/lab.sh shape`.
# Rates use tc units (mbit, gbit; mibit = 2^20 bit): 800mibit = 100 MiB/s.
DOWN_RATE=${DOWN_RATE:-800mibit}
UP_RATE=${UP_RATE:-800mibit}
RTT_MS=${RTT_MS:-1}
# The lab daemon's local SSD (cgroup io.max). 0 = no limit.
DISK_MIBPS=${DISK_MIBPS:-300}
DISK_IOPS=${DISK_IOPS:-0}
