{
  "boot-source": {
    "kernel_image_path": "@KERNEL@",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda rw init=/lib/systemd/systemd"
  },
  "drives": [
    { "drive_id": "root", "path_on_host": "@ROOT@", "is_root_device": true, "is_read_only": false, "cache_type": "Writeback", "io_engine": "Async" },
    { "drive_id": "data", "path_on_host": "@DATA@", "is_root_device": false, "is_read_only": false, "cache_type": "Writeback", "io_engine": "Async" }
  ],
  "network-interfaces": [
    { "iface_id": "eth0", "guest_mac": "06:00:AC:1E:00:02", "host_dev_name": "fc-tap0" }
  ],
  "machine-config": { "vcpu_count": 2, "mem_size_mib": @MEM_MIB@ }
}
