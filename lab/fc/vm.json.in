{
  "boot-source": {
    "kernel_image_path": "@KERNEL@",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda rw init=@INIT@"
  },
  "drives": [
    {
      "drive_id": "root",
      "path_on_host": "@DRIVE@",
      "is_root_device": true,
      "is_read_only": false,
      "cache_type": "Writeback",
      "io_engine": "@IO_ENGINE@"
    }
  ],
  "network-interfaces": [
    { "iface_id": "eth0", "guest_mac": "06:00:AC:1E:00:02", "host_dev_name": "fc-tap0" }
  ],
  "machine-config": { "vcpu_count": @VCPUS@, "mem_size_mib": @MEM_MIB@ }
}
